{
  "manifest_version": 3,
  "name": "东营继续教育网自动学习助手",
  "version": "1.0.0",
  "description": "自动化东营继续教育网的登录、视频播放和考试",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "http://sddy.gxk.yxlearning.com/*",
    "https://sddy.gxk.yxlearning.com/*",
    "http://*.bokecc.com/*",
    "https://*.bokecc.com/*",
    "http://*.polyv.net/*",
    "https://*.polyv.net/*",
    "http://*.baijiayun.com/*",
    "https://*.baijiayun.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://sddy.gxk.yxlearning.com/*",
        "https://sddy.gxk.yxlearning.com/*",
        "http://*.bokecc.com/*",
        "https://*.bokecc.com/*",
        "http://*.polyv.net/*",
        "https://*.polyv.net/*",
        "http://*.baijiayun.com/*",
        "https://*.baijiayun.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
